{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/license-digest",
      "schedule": "0 0 1,16 * *"
    },
    {
      "path": "/api/cron/license-payment",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/publishing-trigger",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/luna-knowledge-merge",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/luna-trace-weekly",
      "schedule": "0 19 * * 0"
    },
    {
      "path": "/api/cron/luna-selfstudy",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/luna-consolidate",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/luna-eval",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/luna-self-upgrade",
      "schedule": "0 19 * * 6"
    },
    {
      "path": "/api/cron/luna-model-inspect",
      "schedule": "50 18 * * 6"
    },
    {
      "path": "/api/cron/luna-self-report",
      "schedule": "0 23 * * 0"
    },
    {
      "path": "/api/cron/luna-morning",
      "schedule": "0 23 * * *"
    }
  ]
}
