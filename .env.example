NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# 아슐랭 /restaurants — 카카오맵(JS 키) + 로컬 키워드 검색(REST 키, 서버 전용)
NEXT_PUBLIC_KAKAO_MAP_KEY=
KAKAO_REST_API_KEY=

# LUNA 엔진 — OpenAI / Gemini / Artificial Analysis (서버 전용)
LUNA_OPENAI_API_KEY=
LUNA_GOOGLE_API_KEY=
LUNA_ARTIFICIAL_ANALYSIS_API_KEY=

# 트렌드 레이더 /research — AI API 키 (서버 전용)
hubtrendchat_claude=
hubtrendchat_geminai=
# ChatGPT — 미사용, 추후 fallback/수집용 준비만
hubtrendchat_chatgpt=

# LUNA — Notion 커넥터 (서버 전용)
NOTION_TOKEN=
# LUNA — Work서버 이미지 색인 (scripts/index-media.ts, 회사 PC)
# MEDIA_VISION_MODEL=claude-haiku-4-5
# SCAN_UNC_T=\\aiw\work
# SCAN_UNC_P=\\aiw\partners
# LUNA — 레퍼런스 검색 (서버 전용)
TAVILY_API_KEY=
YOUTUBE_API_KEY=

# 홈페이지 어드민 — Hub 는 이 URL 만 호출한다 (홈페이지 DB 키를 갖지 않음)
WEBSITE_API_URL=
WEBSITE_ADMIN_SECRET=
NEXT_PUBLIC_WEBSITE_ORIGIN=http://localhost:3100
